# ---------------------------------------------------------------------------
# Shoogle — local environment template
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored and MUST NEVER
# be committed. This file contains variable NAMES ONLY — never real values.
#
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Anything without that prefix stays server-side / build-time only.
#
# IMPORTANT: every EXPO_PUBLIC_* value ships inside the Android APK/AAB and is
# readable by anyone who downloads the app. Only put publishable keys there.
# ---------------------------------------------------------------------------

# --- Supabase (owner: Sunny) -----------------------------------------------
# Project URL and publishable/anon key. Safe to ship in the client ONLY because
# Row Level Security protects every table. Create at:
#   https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. NEVER prefix with EXPO_PUBLIC_. NEVER import into the app.
# Server-side / migration tooling only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google (owner: Pranay — GBP/SEO) --------------------------------------
# Google Cloud OAuth client. The Android client ID is public by design; the
# client SECRET must never reach the device.
# Create at: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_OAUTH_CLIENT_ID_WEB=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Meta / Instagram (owner: Yash — Social) --------------------------------
# Create at: https://developers.facebook.com/apps
EXPO_PUBLIC_META_APP_ID=
META_APP_SECRET=

# --- LinkedIn (owner: Yash — Social) ---------------------------------------
# Create at: https://www.linkedin.com/developers/apps
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- AI generation (owner: Yash / Devashish) -------------------------------
# Server-side only. A generation key on-device can be extracted and abused.
# Create at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Billing (owner: Aryan) ------------------------------------------------
# Razorpay key id is publishable; the secret is server-side only.
# Create at: https://dashboard.razorpay.com/app/website-app-settings/api-keys
EXPO_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Build / release -------------------------------------------------------
# EAS project id (created by `eas init`). Not a secret.
EAS_PROJECT_ID=
# Play Store versionCode. Must increase on every upload.
ANDROID_VERSION_CODE=1

# --- Development switches --------------------------------------------------
# When "1", screens may render clearly-labelled FIXTURE data so UI states can be
# built before backends exist. Every fixture surface renders a visible
# "FIXTURE DATA" banner. This flag is forced off in production builds.
EXPO_PUBLIC_ENABLE_FIXTURES=0

# When "1", the sign-in screen offers "Preview the app without signing in",
# which relaxes the route guard so the four tabs can be walked before
# authentication exists. It signs nobody in and shows no real data; every screen
# carries an undismissable "Preview mode" banner while it is on.
# Development only - forced off in preview and production builds.
EXPO_PUBLIC_DEV_PREVIEW=0
